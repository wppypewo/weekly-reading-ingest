{
  "vaultRoot": "~/ClaudeCode/KnowledgeBase/Ricky-KnowledgeBase",
  "vaultRootNote": "本機 vault 路徑；~ 是家目錄，使用前先展開成絕對路徑（echo $HOME）。換機器時只改這一處",
  "language": "zh-TW",
  "routine": {
    "provider": "claude",
    "enabled": false,
    "tested": false,
    "dayOfWeek": "Saturday",
    "time": "10:07",
    "timezone": "Asia/Taipei"
  },
  "cloud": {
    "detectEnv": "CLAUDE_CODE_REMOTE",
    "vaultRepo": "wppypewo/ricky-knowledgebase",
    "vaultRootRelative": "../ricky-knowledgebase",
    "vaultReadOnly": true,
    "reportBranchPrefix": "claude/",
    "note": "雲端 routine 時（環境變數 CLAUDE_CODE_REMOTE=true）不用 vaultRoot，改用相對於 toolRoot 的 vaultRootRelative；解析規則見 routine-design.md 4.6。clone 目錄名未經實測，以 routine-test-001 結果為準"
  },
  "localScheduler": {
    "enabled": false
  },
  "phoneReminder": {
    "externalOnly": true,
    "purpose": "remind user to open Claude and confirm weekly pick"
  },
  "weeklyPickCount": {
    "main": 1,
    "backup": 2
  },
  "freeOnly": true,
  "confirmationRequiredBeforeIngest": true,
  "allowedConceptDomains": [
    "ai-engineering",
    "ai-workflow",
    "french",
    "human-sciences"
  ],
  "allowedSourceFolders": [
    "articles",
    "papers",
    "videos",
    "books"
  ],
  "paths": {
    "runsDir": "runs",
    "previewDirName": "ingest-preview"
  },
  "mainPickThreshold": {
    "minSourceQuality": 3,
    "minRelevance": 3,
    "requireFreeAccessYes": true,
    "requireDomainInAllowed": true
  },
  "modes": {
    "default": "strict",
    "available": ["strict", "quick"]
  },
  "processedPolicy": {
    "markProcessedWhenConceptProduced": true,
    "note": "weekly-reading source 若同輪已產出至少一篇 concept note 且 output notes/log 完成，可標 processed: true，並同時把 status 改成 active；concept note 內必含該 source 的 wikilink 以通過 lint"
  }
}
